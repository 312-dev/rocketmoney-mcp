{
  "name": "rocketmoney-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Rocket Money: read finances (accounts, transactions, spending, budgets, net worth, subscriptions, categories) and write transaction notes + categories.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rocketmoney-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "deploy": "npm run build && launchctl kickstart -k gui/$(id -u)/com.akseldkw.rocketmoney-mcp",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/tdd-guard-reporter.mjs --test-reporter-destination=stdout test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "refresh-hashes": "tsx scripts/refresh-hashes.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "express": "^4.21.2",
    "jmap-jam": "^0.13.2",
    "mcp-utils": "github:akseldkw07/mcp-utils#v0.1.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "rebrowser-puppeteer-core": "^24.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@urql/core": "^6.0.3",
    "acorn": "^8.19.0",
    "graphql": "^17.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
